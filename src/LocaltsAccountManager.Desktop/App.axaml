<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LocaltsAccountManager.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="AccentRed" Color="#C0392B"/>
        <SolidColorBrush x:Key="RowBackground" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#3A3A3A"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
    </Application.Styles>
</Application>
