<Window x:Class="LocaltsAccountManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Localts Account Manager" Height="820" Width="1280">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding AuthProfileStatus}" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}"/>

        <TabControl Grid.Row="1">
            <!-- Batch processing -->
            <TabItem Header="Batch">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Import TXT" Command="{Binding ImportTxtCommand}" Margin="0,0,8,8"
                                ToolTip="Import credentials into this batch only — not added to Pool. Then Start Processing. Dump lines with REFRESHTOKEN: M.C… are accepted."/>
                        <Button Content="Extract MSA Refresh Tokens" Command="{Binding ExtractMsaRefreshTokensCommand}" Margin="0,0,8,8"
                                ToolTip="From dump lines (email:pass | … | REFRESHTOKEN: M.C…), write clean username:refresh lines for import."/>
                        <Button Content="Start Processing" Command="{Binding StartProcessingCommand}" Margin="0,0,8,8"/>
                        <Button Content="Cancel" Command="{Binding CancelProcessingCommand}" Margin="0,0,8,8"/>
                        <Button Content="Retry Failed" Command="{Binding RetryFailedCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export Usernames" Command="{Binding ExportUsernamesCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export Access Tokens" Command="{Binding ExportAccessTokensCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export Refresh Tokens" Command="{Binding ExportRefreshTokensCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export Ready ZIP" Command="{Binding ExportAccessTokensZipCommand}" Margin="0,0,8,8"
                                ToolTip="Export tokens collected so far — batch can keep running"/>
                        <Button Content="Export Failed Records" Command="{Binding ExportFailedRecordsCommand}" Margin="0,0,8,8"/>
                        <Button Content="Diagnostics" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>

                    <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Total, StringFormat=Total: {0}}"/>
                        <TextBlock Text="{Binding Pending, StringFormat=Pending: {0}}"/>
                        <TextBlock Text="{Binding Processing, StringFormat=Processing: {0}}"/>
                        <TextBlock Text="{Binding Succeeded, StringFormat=Succeeded: {0}}"/>
                        <TextBlock Text="{Binding Failed, StringFormat=Failed: {0}}"/>
                        <TextBlock Text="{Binding RateLimited, StringFormat=Rate limited: {0}}"/>
                    </UniformGrid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Refresh account"
                                          Command="{Binding RefreshBatchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding ProcessingState}" Width="120"/>
                            <DataGridTextColumn Header="Provided Name" Binding="{Binding ProvidedUsername}" Width="120"/>
                            <DataGridTextColumn Header="MC Username" Binding="{Binding AuthenticatedMinecraftUsername}" Width="120"/>
                            <DataGridTextColumn Header="MC token" Binding="{Binding MinecraftTokenRemaining}" Width="120"/>
                            <DataGridTextColumn Header="MC status" Binding="{Binding MinecraftTokenStatus}" Width="100"/>
                            <DataGridTextColumn Header="MSA access" Binding="{Binding MicrosoftTokenRemaining}" Width="110"/>
                            <DataGridTextColumn Header="Refresh updated" Binding="{Binding RefreshUpdatedText}" Width="130"/>
                            <DataGridTextColumn Header="UUID" Binding="{Binding AuthenticatedMinecraftUuid}" Width="200"/>
                            <DataGridTextColumn Header="Line" Binding="{Binding SourceLine}" Width="50"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorCategory}" Width="120"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding ServiceErrorDetail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="3" Header="Selected Record" Margin="0,8,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding SelectedAccount.AuthenticatedMinecraftUsername, StringFormat=Username: {0}}"/>
                            <TextBlock Text="{Binding SelectedMinecraftTokenRemaining, StringFormat=MC access remaining: {0}}"/>
                            <TextBlock Text="{Binding SelectedAccount.ServiceErrorDetail, StringFormat=Detail: {0}}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Pool: all uploaded accounts, auto-managed -->
            <TabItem Header="Pool">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Import from Localts" Command="{Binding ImportFromLocaltsCommand}" Margin="0,0,8,8"
                                ToolTip="Fetch all packaged orders from your Localts account and add them to the pool"/>
                        <Button Content="Import TXT to Pool" Command="{Binding ImportTxtToPoolCommand}" Margin="0,0,8,8"
                                ToolTip="Import a credential TXT into the pool (and current batch for viewing)"/>
                        <Button Content="Refresh Pool" Command="{Binding RefreshPoolCommand}" Margin="0,0,8,8"
                                ToolTip="Refresh every account in the pool"/>
                        <Button Content="Cancel" Command="{Binding CancelPoolCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export Pool ZIP" Command="{Binding ExportPoolZipCommand}" Margin="0,0,8,8"
                                ToolTip="Export ready Minecraft access tokens — one .txt per username in a ZIP"/>
                        <Button Content="Export Pool Refresh Tokens" Command="{Binding ExportPoolRefreshTokensCommand}" Margin="0,0,8,8"
                                ToolTip="Export Microsoft OAuth refresh tokens (username:token) for all pool accounts"/>
                        <Button Content="Export Pool Usernames" Command="{Binding ExportPoolUsernamesCommand}" Margin="0,0,8,8"
                                ToolTip="Export Minecraft usernames for every account in the pool"/>
                        <Button Content="Export Meteor SESSION" Command="{Binding Donut.ExportMeteorSessionsCommand}" Margin="0,0,8,8"
                                ToolTip="Minecraft access JWTs (~24h). In artuurssclient: Accounts → Session — not Refresh Token."/>
                        <Button Content="Reload list" Command="{Binding ReloadPoolListCommand}" Margin="0,0,8,8"/>
                        <CheckBox Content="Auto-refresh pool in background"
                                  IsChecked="{Binding PoolAutoManageEnabled}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,8"
                                  ToolTip="Off by default. When on, refreshes expiring tokens on a timer — never automatically when you open the app."/>
                    </WrapPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="LOCALTS API KEY" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="LocaltsApiKeyBox" PasswordChanged="LocaltsApiKeyBox_PasswordChanged"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Save key" Command="{Binding SaveLocaltsApiKeyCommand}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="2" Content="Test" Command="{Binding TestLocaltsConnectionCommand}" VerticalAlignment="Bottom"/>
                    </Grid>

                    <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,8">
                        <TextBlock Text="{Binding PoolTotal, StringFormat=Total: {0}}"/>
                        <TextBlock Text="{Binding PoolPending, StringFormat=Pending: {0}}"/>
                        <TextBlock Text="{Binding PoolReadyCount, StringFormat=Ready: {0}}"/>
                        <TextBlock Text="{Binding PoolSucceeded, StringFormat=Succeeded: {0}}"/>
                        <TextBlock Text="{Binding PoolFailed, StringFormat=Failed: {0}}"/>
                        <TextBlock Text="{Binding PoolRemovedCount, StringFormat=Removed: {0}}"/>
                    </UniformGrid>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding PoolAccounts}"
                              SelectedItem="{Binding SelectedPoolAccount}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding ProcessingState}" Width="120"/>
                            <DataGridTextColumn Header="Provided Name" Binding="{Binding ProvidedUsername}" Width="120"/>
                            <DataGridTextColumn Header="MC Username" Binding="{Binding AuthenticatedMinecraftUsername}" Width="120"/>
                            <DataGridTextColumn Header="MC token" Binding="{Binding MinecraftTokenRemaining}" Width="120"/>
                            <DataGridTextColumn Header="MC status" Binding="{Binding MinecraftTokenStatus}" Width="100"/>
                            <DataGridTextColumn Header="MSA access" Binding="{Binding MicrosoftTokenRemaining}" Width="110"/>
                            <DataGridTextColumn Header="Refresh updated" Binding="{Binding RefreshUpdatedText}" Width="130"/>
                            <DataGridTextColumn Header="UUID" Binding="{Binding AuthenticatedMinecraftUuid}" Width="200"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorCategory}" Width="120"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding ServiceErrorDetail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Text="{Binding LocaltsConnectionStatus}" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Text="{Binding PoolStatusMessage}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Localts-style account library -->
            <TabItem Header="Accounts">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SEARCH" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search accounts…"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Import TXT" Command="{Binding ImportActiveTxtCommand}" Margin="0,0,8,0"
                                    ToolTip="Import credentials for the active library only — not added to the pool"/>
                            <Button Content="Export Meteor SESSION" Command="{Binding Donut.ExportMeteorSessionsCommand}" Margin="0,0,8,0"
                                    ToolTip="Minecraft access JWTs (~24h). In artuurssclient: Accounts → Session — not Refresh Token."/>
                            <Button Content="Export ZIP" Command="{Binding ExportAccessTokensZipCommand}" Margin="0,0,8,0"
                                    ToolTip="Export all tokens ready now — one .txt per username. Safe to use while batch is still running."/>
                            <Button Content="Export Usernames" Command="{Binding ExportLibraryUsernamesCommand}" Margin="0,0,8,0"
                                    ToolTip="Export Minecraft usernames from active Accounts"/>
                            <Button Content="Refresh list" Command="{Binding RefreshLibraryCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="ACTIVE ACCOUNTS (" FontWeight="SemiBold"/>
                            <Run Text="{Binding LibraryReadyCount}" FontWeight="SemiBold"/>
                            <Run Text=")" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="Valid tokens only — expired hidden" HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"/>
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding LibraryView}"
                             SelectedItem="{Binding SelectedLibraryAccount}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{StaticResource RowBackground}"
                                                    CornerRadius="6" Padding="10,8"
                                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="#E8E8E8">
                                        <Image Source="{Binding SkinImage}" Width="32" Height="32" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding Subtitle}" Margin="8,0,0,0"
                                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Uuid}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ExpiryText}" VerticalAlignment="Center"
                                               Margin="0,0,12,0" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpired}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasAccessToken}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="3" Content="⋮" Width="28" Height="28" Padding="0"
                                            VerticalAlignment="Center" Tag="{Binding}" Click="AccountMenuButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy username"
                                                          Command="{Binding CopyLibraryUsernameCommand}"
                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Copy UUID"
                                                          Command="{Binding CopyLibraryUuidCommand}"
                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Copy Minecraft access token (Session)"
                                                          Command="{Binding CopyLibraryAccessTokenCommand}"
                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Copy OAuth refresh token (long-lived)"
                                                          Command="{Binding CopyLibraryRefreshTokenCommand}"
                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Text="{Binding LibraryStatusMessage}"/>
                </Grid>
            </TabItem>

            <!-- DonutSMP player comparer -->
            <TabItem Header="Donut">
                <Grid Margin="0,8,0,0" DataContext="{Binding Donut}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Load from Batch" Command="{Binding LoadFromBatchCommand}" Margin="0,0,8,8"
                                ToolTip="Loads usernames from the current Batch tab import"/>
                        <Button Content="Load from Pool" Command="{Binding LoadFromPoolCommand}" Margin="0,0,8,8"/>
                        <Button Content="Load from Accounts" Command="{Binding LoadFromAccountsCommand}" Margin="0,0,8,8"/>
                        <Button Content="Start scan" Command="{Binding StartScanCommand}" Margin="0,0,8,8"/>
                        <Button Content="Stop" Command="{Binding StopScanCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export Meteor SESSION" Command="{Binding ExportMeteorSessionsCommand}" Margin="0,0,8,8"
                                ToolTip="Minecraft access JWTs (~24h). In artuurssclient: Accounts → Session — not Refresh Token."/>
                        <Button Content="Export username:uuid:token" Command="{Binding ExportSessionLinesDetailedCommand}" Margin="0,0,8,8"/>
                        <Button Content="Copy username" Command="{Binding CopySelectedUsernameCommand}" Margin="0,0,8,8"/>
                        <Button Content="Copy access token" Command="{Binding CopySelectedAccessTokenCommand}" Margin="0,0,8,8"
                                ToolTip="Copies Minecraft access JWT for Accounts → Session (not Refresh Token)."/>
                    </WrapPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="HYPIXEL API KEY" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding HypixelApiKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="DONUT API KEY (/api in game)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DonutApiKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Save keys" Command="{Binding SaveApiKeysCommand}" VerticalAlignment="Bottom"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding SettingsSummary}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="USERNAMES" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding UsernameText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12"/>
                        </DockPanel>
                        <DataGrid Grid.Column="1" Margin="8,0,0,0"
                                  ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding DonutSource}" Width="70"/>
                                <DataGridTextColumn Header="Money" Binding="{Binding DonutMoney}" Width="100"/>
                                <DataGridTextColumn Header="Shards" Binding="{Binding DonutShards}" Width="70"/>
                                <DataGridTextColumn Header="Kills" Binding="{Binding DonutKills}" Width="70"/>
                                <DataGridTextColumn Header="Deaths" Binding="{Binding DonutDeaths}" Width="70"/>
                                <DataGridTextColumn Header="Playtime" Binding="{Binding DonutPlaytime}" Width="100"/>
                                <DataGridTextColumn Header="Donut NW" Binding="{Binding DonutNetWorth}" Width="100"/>
                                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding BridgeStatusText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding LastExportSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
    </Grid>
</Window>
