<Application x:Class="LocaltsAccountManager.App.App"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <SolidColorBrush x:Key="RowBackground" Color="#F5F5F5"/>

        <SolidColorBrush x:Key="RowHover" Color="#EAEAEA"/>

        <SolidColorBrush x:Key="AccentRed" Color="#C0392B"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666666"/>

        <SolidColorBrush x:Key="BorderSubtle" Color="#DDDDDD"/>

    </Application.Resources>

</Application>

