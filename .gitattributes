* text=auto eol=crlf

*.cs text diff=csharp
*.xaml text
*.csproj text
*.sln text
*.md text
*.json text
*.ps1 text

*.png binary
*.jpg binary
*.webp binary

# Arch packaging must stay LF or Wine/bash shebangs break on Linux.
packaging/arch/PKGBUILD text eol=lf
packaging/arch/*.sh text eol=lf
packaging/arch/*.install text eol=lf
packaging/arch/*.desktop text eol=lf
packaging/arch/localts-account-manager text eol=lf
