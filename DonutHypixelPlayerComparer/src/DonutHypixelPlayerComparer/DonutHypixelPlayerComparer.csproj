    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DonutHypixelPlayerComparer</AssemblyName>
    <RootNamespace>DonutHypixelPlayerComparer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\DonutComparer.Core\DonutComparer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Infrastructure\**\*.cs" />
  </ItemGroup>
</Project>
