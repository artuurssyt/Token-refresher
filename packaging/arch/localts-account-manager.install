post_install() {
  echo "Localts Account Manager is a native Avalonia linux-x64 GUI."
  echo "It does not use Wine."
  echo
  echo "Launch: localts-account-manager"
  echo "Data:   ~/.local/share/LocaltsAccountManager/"
  echo
  echo "Tokens do not refresh on first launch."
}

post_upgrade() {
  post_install
}
