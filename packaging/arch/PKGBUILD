# Maintainer: artuurssyt
# Local package: extract the GitHub Arch tarball, then run `makepkg -si` from this directory.
# Native Avalonia linux-x64 GUI. Not Wine.

pkgname=localts-account-manager
pkgver=1.2.0
pkgrel=1
pkgdesc="Microsoft/Minecraft account manager (native Avalonia GUI)"
arch=('x86_64')
url="https://github.com/artuurssyt/Token-refresher"
license=('unknown')
install=localts-account-manager.install
depends=(
  'libx11'
  'libice'
  'libsm'
  'libxext'
  'libxrandr'
  'libxi'
  'libxcursor'
  'libxrender'
  'libxkbcommon'
  'fontconfig'
  'freetype2'
  'harfbuzz'
  'icu'
  'mesa'
  'ttf-dejavu'
)
optdepends=(
  'xorg-xwayland: run the X11 window on a Wayland compositor'
)
source=(
  "localts-account-manager"
  "localts-account-manager.desktop"
)
sha256sums=(
  'SKIP'
  'SKIP'
)

package() {
  install -d "$pkgdir/usr/share/localts-account-manager"
  install -Dm755 "$srcdir/localts-account-manager" \
    "$pkgdir/usr/share/localts-account-manager/localts-account-manager"

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/localts-account-manager" <<'EOF'
#!/usr/bin/env bash
exec /usr/share/localts-account-manager/localts-account-manager "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/localts-account-manager"

  install -Dm644 "$srcdir/localts-account-manager.desktop" \
    "$pkgdir/usr/share/applications/localts-account-manager.desktop"

  if [[ -f "$startdir/README-ARCH.md" ]]; then
    install -Dm644 "$startdir/README-ARCH.md" \
      "$pkgdir/usr/share/doc/localts-account-manager/README-ARCH.md"
  fi
  if [[ -f "$startdir/SHA256SUMS" ]]; then
    install -Dm644 "$startdir/SHA256SUMS" \
      "$pkgdir/usr/share/doc/localts-account-manager/SHA256SUMS"
  fi
}
